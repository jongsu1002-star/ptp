:root {
}

.inventory-panel {
    width: 415px;
    position: absolute;
    height: 450px;
    background-color: rgb(0, 0, 0);
    align-self: center;
    margin-top: 10px;
    padding: 15px;
    border-left-color: rgb(255, 235, 0);
    border-right-color: rgb(255, 235, 0);
    border-top-color: rgb(255, 235, 0);
    border-bottom-color: rgb(255, 235, 0);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    border-bottom-left-radius: 8px;
}

.inventory-title {
    font-size: 20px;
    color: rgb(245, 245, 245);
    -unity-text-align: upper-center;
    -unity-font-style: bold;
    margin-bottom: 10px;
}

.slot-grid {
    border-left-color: rgb(255, 255, 255);
    border-right-color: rgb(255, 255, 255);
    border-top-color: rgb(255, 255, 255);
    border-bottom-color: rgb(255, 255, 255);
    border-top-width: 2px;
    border-left-width: 2px;
    border-top-left-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    border-top-right-radius: 8px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    -unity-background-image-tint-color: rgb(43, 47, 45);
    padding-top: 8px;
    padding-left: 8px;
    padding-right: 8px;
    padding-bottom: 8px;
    flex-direction: row;
    flex-wrap: wrap;
    height: 260px;
    margin-bottom: 0;
    background-color: rgb(51, 51, 51);
}

.info-box {
    height: auto;
    border-top-color: rgb(255, 255, 255);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-top-left-radius: 8px;
    border-left-width: 2px;
    border-left-color: rgb(255, 255, 255);
    border-top-right-radius: 8px;
    border-bottom-width: 2px;
    border-bottom-color: rgb(255, 255, 255);
    border-right-color: rgb(255, 255, 255);
    padding-top: 0;
    padding-left: 0;
    padding-bottom: 0;
    padding-right: 0;
    margin-top: 6px;
}

.info-text {
    font-size: 17px;
    color: rgb(255, 255, 255);
    padding-left: 20px;
}

.inventory-slot {
    background-color: rgb(255, 255, 255);
    width: 80px;
    height: 80px;
    border-left-width: 2px;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-top-color: rgb(0, 0, 255);
    border-left-color: rgb(0, 0, 255);
    border-right-color: rgb(0, 0, 255);
    border-bottom-color: rgb(0, 0, 255);
    margin-top: 5px;
    margin-right: 5px;
    margin-bottom: 5px;
    margin-left: 5px;
    justify-content: center;
    align-items: center;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
}
.inventory-slot:hover {
    background-color: rgb(10, 56, 35);
    border-color: rgb(186, 233, 18);
}
.slot-icon{
    width:64px;
    height:64px;
}
.slot-label{
    position:absolute;
    text-align:center;
    width:16px;
    height:16px;
    right:0px;
    bottom:2px;
    padding:0;
    -unity-font-style:bold;
}
