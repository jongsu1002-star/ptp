<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Inventory.uss?fileID=7433441132597879392&amp;guid=8da59947e6705e946b38b492351b5fd5&amp;type=3#Inventory"/>
    <ui:VisualElement name="InventoryRoot" class="inventory-panel" style="flex-grow: 1;">
        <ui:Label text="Inventory" name="TitleLabel" class="inventory-title" style="color: rgb(245, 245, 245); font-size: 20px; -unity-font-style: bold; -unity-text-align: upper-center; padding-right: 2px; padding-left: 2px;"/>
        <ui:VisualElement name="SlotContainer" class="slot-grid" style="flex-grow: 1;"/>
        <ui:VisualElement name="InfoBox" class="info-box" style="flex-grow: 1;">
            <ui:Label text="Label" name="ItemInfoLabel" class="info-text"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
